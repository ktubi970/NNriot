# Riot Games API key — get one at https://developer.riotgames.com/
RIOT_API_KEY=your_api_key_here

# Fresh-install SQLite examples. Set these to your actual source and analytics paths.
NNRIOT_DB_PATH=training_data.db
NNRIOT_ANALYTICS_DB_PATH=analytics.db
NNRIOT_ANALYTICS_SEED=20260716

# Optional absolute checkpoint path for the historical continuous trainer
# NNRIOT_CHECKPOINT_PATH=D:/projet/NNriot/runs/candidate_deepsets_v3/model.keras
# NNRIOT_MODEL_MANIFEST_PATH=D:/projet/NNriot/docs/model_serving/reference.manifest.json

# Flask web server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Comma-separated CORS allowlist for the web API
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Enable the mock OCR endpoint (returns hardcoded fake roster data)
# Set to 1 only for local testing of the live stream UI
MOCK_OCR_ENABLED=0
