+    db = tmp_path / 'partial.db'
+    old = source_row('NA1_old', 10, 20)
+    with sqlite3.connect(db) as conn:
+        conn.executescript('''
+            CREATE TABLE matches(match_id TEXT, game_creation_time INTEGER,
+                                 game_mode TEXT, raw_json TEXT);
