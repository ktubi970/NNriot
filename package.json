{
  "name": "nnriot",
  "version": "2.0.0",
  "description": "NNriot Web & ML Analytics Platform",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "test:unit": "node --test tests/frontend/api.test.cjs",
    "test:e2e": "playwright test --config playwright.cockpit.config.ts",
    "test:e2e:legacy": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.cockpit.config.ts --ui",
    "test:e2e:headed": "playwright test --config playwright.cockpit.config.ts --headed",
    "test:e2e:debug": "playwright test --config playwright.cockpit.config.ts --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  }
}
